{
    "name": "fortune-cat-service",
    "version": "1.0.0",
    "description": "",
    "main": "./src/app.js",
    "author": "pentagon",
    "license": "ISC",
    "type": "module",
    "scripts": {
        "start": "node --es-module-specifier-resolution=node .",
        "dev": "nodemon --es-module-specifier-resolution=node --watch ./src ./src/app.js",
        "debug": "nodemon --es-module-specifier-resolution=node --watch ./ --inspect ./src/app.js",
        "prod": "node --max-old-space-size=8192 --es-module-specifier-resolution=node ./src/app.js",
        "reg": "npm set registry http://npm.lumigame.com",
        "test": "jest --testPathPattern=tests/unit-tests/",
        "test-coverage": "jest --testPathPattern=tests/unit-tests/ --collect-coverage",
        "integration-test": "jest tests/integration-tests/index.test.js --ci --reporters=default --reporters=jest-junit --forceExit"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "dependencies": {
        "sc-slot-game-base": "3.4.0"
    },
    "resolutions": {
        "sc-game-base": "5.4.0",
        "sc-base-apis": "3.0.2",
        "sc-base-database": "2.3.0"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.14.9",
        "@commitlint/cli": "^9.1.2",
        "@commitlint/config-conventional": "^9.1.2",    
        "@types/jest": "^26.0.24",
        "babel-jest": "^27.0.6",
        "husky": "^4.2.5",
        "install": "^0.13.0",
        "jest": "^26.4.2",
        "jest-extended": "^0.11.5",
        "jest-junit": "^12.2.0",
        "jest-sonar-reporter": "^2.0.0",
        "nodemon": "^2.0.4",
        "sc-game-service-integration-utils": "2.3.1"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
